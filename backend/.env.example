# PostgreSQL (Neon) connection string. Leave empty to use local SQLite (studyai.db).
# Example: postgresql+psycopg://user:password@ep-xxxx.neon.tech/studyai?sslmode=require
DATABASE_URL=

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Google Gemini (used in Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=

# Email verification via Gmail SMTP. Leave SMTP_USER empty to print codes in the server terminal (dev mode).
# SMTP_PASSWORD must be a Gmail *App Password* (Google Account → Security → 2-Step Verification → App passwords),
# not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=StudyAI
# Reject addresses whose domain can't receive mail (DNS MX lookup)
EMAIL_CHECK_DELIVERABILITY=true
