# development (default) or production. In production the server refuses to start
# unless JWT_SECRET, DATABASE_URL and a real email provider are configured.
ENVIRONMENT=development

# PostgreSQL (Neon) connection string. Leave empty to use local SQLite (studyai.db).
# Example: postgresql://user:password@ep-xxxx.neon.tech/studyai?sslmode=require
DATABASE_URL=

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (add the Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# Google Gemini (AI study plans)
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Email (verification & password-reset codes) ---------------------------------
#   console = print codes in this terminal (local development only)
#   brevo   = Brevo HTTP API (recommended; works on Render's free tier, which blocks SMTP)
#   smtp    = any SMTP server (Gmail with an App Password, Brevo SMTP, SendGrid, ...)
EMAIL_PROVIDER=console
EMAIL_FROM=            # sender address (must be verified in Brevo; defaults to SMTP_USER for smtp)
EMAIL_FROM_NAME=StudyAI
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=         # for Gmail: a 16-character App Password, not the normal password
# Reject addresses whose domain can't receive mail (DNS MX lookup)
EMAIL_CHECK_DELIVERABILITY=true

# Login / sign-up / code attempts allowed per IP per window
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
